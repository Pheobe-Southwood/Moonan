{
  "name": "@moonan/plugin-sdk",
  "version": "0.0.1-rc.1",
  "private": true,
  "type": "module",
  "description": "Moonan 插件契约：Chord 服务 token、类型与辅助函数",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "import": "./dist/client.js"
    },
    "./types": {
      "types": "./dist/types.d.ts",
      "import": "./dist/types.js"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "test": "node --test --import tsx \"test/**/*.test.ts\""
  },
  "dependencies": {
    "@earendil-works/chord": "1.1.0",
    "typebox": "1.3.27"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
