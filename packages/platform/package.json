{
  "name": "@moonan_ai/moonan",
  "version": "0.0.4-alpha2",
  "description": "Moonan platform: builds a Chord host, resolves plugin facets, and serves them over a single port.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Pheobe-Southwood/Moonan.git",
    "directory": "packages/platform"
  },
  "bin": {
    "moonan": "./bin/moonan.js"
  },
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./src/index.ts",
      "development": "./src/index.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "bin",
    "src"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build": "tsc -p tsconfig.build.json && node scripts/copy-web.mjs",
    "dev": "tsx watch src/cli.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "@earendil-works/chord": "1.4.0",
    "@moonan_ai/sdk": "workspace:*",
    "typebox": "1.3.27",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@moonan_ai/web": "workspace:*",
    "@types/node": "^22.20.5",
    "@types/ws": "^8.18.2",
    "vitest": "^5.0.5"
  },
  "keywords": [
    "moonan",
    "platform",
    "facet",
    "chord",
    "plugin"
  ],
  "homepage": "https://github.com/Pheobe-Southwood/Moonan#readme",
  "bugs": {
    "url": "https://github.com/Pheobe-Southwood/Moonan/issues"
  },
  "publishConfig": {
    "access": "public"
  }
}
