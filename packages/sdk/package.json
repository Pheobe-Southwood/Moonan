{
  "name": "@moonan_ai/sdk",
  "version": "0.0.4-alpha1",
  "description": "Moonan plugin SDK: contracts, registries and browser hooks for plugin authors.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Pheobe-Southwood/Moonan.git",
    "directory": "packages/sdk"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "development": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./web": {
      "types": "./src/web.ts",
      "development": "./src/web.ts",
      "default": "./dist/web.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build": "tsc -p tsconfig.build.json"
  },
  "dependencies": {
    "@earendil-works/chord": "1.4.0",
    "typebox": "1.3.27"
  },
  "peerDependencies": {
    "react": ">=19.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "react": "^19.3.1"
  },
  "keywords": [
    "moonan",
    "plugin",
    "chord",
    "sdk"
  ],
  "homepage": "https://github.com/Pheobe-Southwood/Moonan#readme",
  "bugs": {
    "url": "https://github.com/Pheobe-Southwood/Moonan/issues"
  },
  "publishConfig": {
    "access": "public"
  }
}
