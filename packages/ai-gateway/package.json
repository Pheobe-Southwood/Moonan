{
  "name": "@moonan_ai/ai-gateway",
  "version": "0.0.4-alpha2",
  "type": "module",
  "description": "Moonan's AI gateway plugin: configure pi-ai providers and models from the 模型 tab.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Pheobe-Southwood/Moonan.git",
    "directory": "packages/ai-gateway"
  },
  "exports": {
    ".": {
      "types": "./src/server.ts",
      "default": "./dist/server.js"
    },
    "./web": {
      "types": "./src/web/web.tsx",
      "default": "./dist/web.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build": "pnpm run build:server && pnpm run build:web",
    "build:server": "tsc -p tsconfig.build.json",
    "build:web": "node scripts/build-web.mjs",
    "test": "vitest run",
    "pretest": "pnpm build"
  },
  "dependencies": {
    "@earendil-works/pi-ai": "1.4.0",
    "@moonan_ai/sdk": "workspace:*",
    "typebox": "1.3.27"
  },
  "peerDependencies": {
    "react": ">=19.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "esbuild": "0.28.2",
    "react": "^19.3.1",
    "vitest": "^5.0.5",
    "@earendil-works/chord": "1.4.0",
    "@types/ws": "^8.18.2",
    "ws": "^8.22.0"
  },
  "keywords": [
    "moonan",
    "plugin",
    "ai",
    "gateway",
    "pi-ai",
    "chord"
  ],
  "homepage": "https://github.com/Pheobe-Southwood/Moonan#readme",
  "bugs": {
    "url": "https://github.com/Pheobe-Southwood/Moonan/issues"
  },
  "publishConfig": {
    "access": "public"
  }
}
