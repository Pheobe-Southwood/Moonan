{
  "name": "@moonan_ai/web",
  "version": "0.0.3-alpha1",
  "description": "Moonan 的浏览器外壳与共享运行时（构建产物随平台发布）。",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Pheobe-Southwood/Moonan.git",
    "directory": "packages/web"
  },
  "exports": {
    "./package.json": "./package.json",
    "./dist/*": "./dist/*"
  },
  "files": [
    "dist"
  ],
  "private": true,
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build:runtime": "node scripts/build-runtime.mjs",
    "build": "pnpm run build:runtime && vite build",
    "dev": "vite build --watch"
  },
  "dependencies": {
    "@earendil-works/chord": "1.4.0",
    "@moonan_ai/sdk": "workspace:*",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typebox": "1.3.27"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "esbuild": "0.28.2",
    "vite": "^8.3.4"
  }
}
