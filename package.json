{
  "name": "moonan-workspace",
  "version": "0.0.1-alpha2",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "typecheck": "pnpm -r --parallel typecheck",
    "test": "pnpm -r --parallel --if-present test",
    "build": "pnpm -r build",
    "e2e": "node --conditions=development --import tsx scripts/e2e.mjs"
  },
  "devDependencies": {
    "@moonan_ai/testing": "workspace:*",
    "@types/node": "^22.20.5",
    "playwright-core": "1.58.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5"
  }
}
