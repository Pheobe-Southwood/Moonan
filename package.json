{
  "name": "moonan-workspace",
  "version": "0.0.3-alpha1",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "typecheck": "pnpm -r --parallel typecheck",
    "build": "pnpm -r build",
    "test": "pnpm -r --if-present test",
    "dev": "pnpm build && node packages/platform/bin/moonan.js --dev --plugin ./examples/clock-plugin"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "esbuild": "0.28.2",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5"
  }
}
